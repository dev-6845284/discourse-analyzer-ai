# Environment settings
NODE_ENV=local
BYPASS_AUTH=true # Bypasses Google OAuth check for local dev

# Database connection
MONGODB_URI=mongodb://127.0.0.1:27017/discourse-analyzer-dev
DB_CONNECTION_TIMEOUT_MS=5000

# Redis caching and session store (Optional)
# REDIS_URL=redis://127.0.0.1:6379

# Authentication & secrets
SESSION_SECRET=your_session_secret_here
API_KEYS_SECRET=your_api_keys_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
ALLOWED_USERS=email1@example.com,email2@example.com

# LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=your_grok_api_key_here
CHATGPT_API_KEY=your_chatgpt_api_key_here

